# Top-level bundled Python engine dependencies (the human-edited pin list).
# Update these deliberately, then regenerate the hash-pinned lockfile:
#   scripts/lock-python-deps.ps1   (resolves the full transitive tree + hashes)
# The lockfile scripts/python-requirements.txt is what setup-python-embed.ps1
# actually installs, with --require-hashes.
# 10.9+ required: merge/split use Pdf.add_pages_from (form-aware page copy,
# added in pikepdf 10.9) — see engine/acroform.py.
pikepdf==10.11.0
pdfminer.six==20260107
pyHanko==0.36.2
# Replacement-font fallback: subsetting + embedding the bundled OFL
# font (resources/fonts) for characters a document's own font can't
# express. Deliberate dep-bump.
fonttools==4.63.0
# PKCS#11 token signing: pyHanko's pkcs11 arm needs python-pkcs11
# (MIT; import name `pkcs11`). Wheel available for the embedded CPython.
python-pkcs11==0.9.5
# Right-to-left reflow: HarfBuzz (Apache-2.0) shapes cursively joining
# scripts. A PDF viewer never shapes -- the content stream carries final
# glyph choices -- so re-emitting Arabic per character draws every letter in
# its isolated form. The bidi half is engine/bidi.py, ours, because the
# reflow needs the reordering PERMUTATION and no binding exposes it.
uharfbuzz==0.56.0
# MRC compression: exact integral-image local statistics (Sauvola), the
# connected-component pass that keeps photographs and halftones OUT of the
# 1-bit mask, and the masked-mean inpaint that averages the background over
# PAPER pixels only. The Pillow-only form measured in recon is an
# APPROXIMATION of the sliding window with no correctness story, and the
# ghosted background it produces collapses OCR on the very pages this feature
# exists for. BSD-3-Clause; a cp314 win_amd64 wheel exists, so nothing
# compiles at packaging time.
numpy==2.5.1
# HEIC/HEIF decoding. HEIC is a common camera format on phones used to
# photograph documents;
# the bundled Pillow cannot read it (`features.check("heif")` is False —
# measured). AVIF, WEBP and JPEG 2000 are already decodable by Pillow itself.
# BSD-3-Clause for the plugin; its binary wheel bundles libheif/libde265
# (LGPLv3) and x265 (GPLv2) — ordinary notice rows for an MIT open-source
# project with a public repository, listed in THIRD-PARTY-LICENSES.md.
pillow-heif==1.5.0
# Spreadsheet export: the workbook writer for the xlsx target. A spreadsheet
# filter cannot write a page-description document, so the cells come from this
# engine's own table detection and this package writes them. MIT; a
# `none-any` wheel, so nothing compiles at packaging time.
openpyxl==3.1.5
# Presentation export: the deck writer for the pptx target. MIT, `none-any`.
# Its binary transitive dependencies (lxml, Pillow) already resolve here at the
# same versions, so nothing is duplicated or upgraded.
python-pptx==1.0.2
