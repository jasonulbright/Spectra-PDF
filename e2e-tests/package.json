{
  "name": "spectrapdf-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end test harness for Spectra PDF (WebdriverIO + tauri-driver)",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:headed": "wdio run wdio.conf.ts --logLevel info",
    "build:app": "cd .. && cross-env VITE_E2E=1 npx tauri build --debug --no-bundle"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^26.1.2",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "axe-core": "4.12.1",
    "cross-env": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "ts-node": "^10.9.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4",
    "@puppeteer/browsers": "^3.0.2"
  }
}
