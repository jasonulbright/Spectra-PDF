    {
      "name": "simplified field notation: a sum",
      "js": "event.value = Subtotal + Tax;",
      "script": {
        "fn": "SFN",
        "expr": {
          "op": "+",
          "l": {
            "field": "Subtotal"
          },
          "r": {
            "field": "Tax"
          }
        }
      }
    },
    {
      "name": "simplified field notation: precedence and parentheses",
      "js": "event.value = (Price * Qty) - Discount;",
      "script": {
        "fn": "SFN",
        "expr": {
          "op": "-",
          "l": {
            "op": "*",
            "l": {
              "field": "Price"
            },
            "r": {
              "field": "Qty"
            }
          },
          "r": {
            "field": "Discount"
          }
        }
      }
    },
    {
      "name": "simplified field notation: unary minus",
      "js": "event.value = -Adjustment + Base;",
      "script": {
        "fn": "SFN",
        "expr": {
          "op": "+",
          "l": {
            "op": "neg",
            "v": {
              "field": "Adjustment"
            }
          },
          "r": {
            "field": "Base"
          }
        }
      }
    },
    {
      "name": "simplified field notation: a quoted name carrying a space",
      "js": "event.value = \"Line Total\" / 2;",
      "script": {
        "fn": "SFN",
        "expr": {
          "op": "/",
          "l": {
            "field": "Line Total"
          },
          "r": {
            "num": 2.0
          }
        }
      }
    },
    {
