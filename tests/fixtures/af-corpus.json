  "keystroke": [
    {
      "name": "a plain number commits",
      "js": "AFNumber_Keystroke(2, 0, 0, 0, \"\", true);",
      "value": "1234.5",
      "ok": true,
      "stored": "1234.5",
      "problem": null
    },
    {
      "name": "a comma decimal is rejected under a dot separator style",
      "js": "AFNumber_Keystroke(2, 0, 0, 0, \"\", true);",
      "value": "1234,5",
      "ok": false,
      "stored": "1234,5",
      "problem": {
        "kind": "number",
        "args": []
