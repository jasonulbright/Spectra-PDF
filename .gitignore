# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build output
dist/
out/
*.tsbuildinfo

# Tauri / Rust
src-tauri/target/
src-tauri/gen/schemas/

# Environment
.env
.env.local

# IDE / tooling
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Python
*.egg-info/
*.egg
.eggs/

# Embedded runtimes (downloaded/copied during build, not committed)
resources/python/
resources/fonts/
# Ghostscript is NOT provisioned and NOT shipped: it is a user-supplied,
# optional prerequisite the app discovers. No script writes this directory and
# no build reads it; the entry stays so a tree left behind by a build from
# before the change cannot land in git.
resources/ghostscript/
# Native Tesseract (vendored by scripts/bundle-tesseract.ps1; large binaries +
# 47 language models, same repo-hygiene class as resources/python).
resources/tesseract/
# JBIG2 encoder (vendored by scripts/bundle-jbig2enc.ps1; a ~4.8MB static
# binary plus its notice tree — same repo-hygiene class as the above. The
# provision script, the SHA-256 pin and the checked-in notice texts are what
# lives in git; the binary does not).
resources/jbig2enc/
# Hunspell spelling dictionaries (vendored by scripts/bundle-dictionaries.ps1;
# ~147MB of word lists across 34 languages, same repo-hygiene class as the
# above. The pinned manifest with every file's sha256 is what lives in git).
resources/dictionaries/
# ICC colour profiles (staged by scripts/bundle-icc.ps1 from the committed
# copies under vendor/icc, same repo-hygiene class as the above: the resource
# tree is a build output). The profiles themselves, their end-user licence text
# and the pinned manifest with every profile's sha256 live in git.
resources/icc/
# The owner-held bundler package the committed profiles were extracted from.
# It is redistributable only under an agreement carrying an indemnity, so it
# stays with its holder; the standalone-distribution grant is what the
# committed profiles travel under.
AdobeICCProfilesCS4Win_bundler.zip

# Test
coverage/
.pytest_cache/
htmlcov/

# E2E (WebdriverIO + tauri-driver) — runtime artifacts
e2e-tests/.wdio-runs/
e2e-tests/logs/

# Portable staging (built artifacts, not source)
src-tauri/target/release/portable/

# Internal planning docs (not part of the public release)
roadmap.md
NEXT_SESSION.md
project-manifest.json
.updater-test/

# OCR runtime assets — generated by scripts/sync-ocr-assets.mjs from the
# pinned tesseract.js packages; vendored in the product, not in git (same
# class as resources/python).
/public/ocr/
# pdf.js runtime assets (wasm image decoders, CMaps, standard fonts, the CMYK
# ICC profile) — staged by scripts/sync-pdfjs-assets.mjs out of the pinned
# pdfjs-dist package. Same class: vendored in the product, not in git.
/public/pdfjs/

# Internal dev record — local working files, NEVER committed. They must
# never reach the public repo.
CLAUDE.md
docs/PUNCHLIST.md
docs/architecture/
docs/reviews/
# The doc map, archived tracker history, and external-baseline reference
# material: internal-only, must never reach the public repo.
docs/README.md
docs/archive/
docs/reference/
# Licensed specification PDFs, obtained under a sponsored-access grant that
# permits reading and not redistribution. This repository is public, so a
# commit here republishes them.
/pdfa/
# Public PDF/A conformance suites (bfocom/pdfa-testsuite, veraPDF/veraPDF-corpus,
# which bundles Isartor), fetched by scripts/fetch-pdfa-corpus.py. NEITHER
# DECLARES A LICENCE, so they are read on a developer disk and never
# redistributed. This repository is public.
/pdfa-corpus/
*.local.*
# ...and scratch DIRECTORIES, which the pattern above misses: it needs a dot
# after "local", so `u1-shots.local/` was landing in git status as untracked.
*.local/
# Owner's scratch input file (instructions dropped in for a session).
userinput.md

# LibreOffice runtime for Office export (assembled by scripts/bundle-libreoffice.ps1;
# large, gitignored like resources/python & resources/ghostscript).
resources/libreoffice/
tests/softhsm2/
