#!/bin/sh
# AppImage entry point. WebKitGTK and GTK come from the host system; a host
# without them gets a message that names the libraries and the packages,
# instead of a dynamic-loader error.

HERE="$(dirname "$(readlink -f "$0")")"
: "${APPDIR:=$HERE}"
export APPDIR

REQUIRED="libwebkit2gtk-4.1.so.0 libjavascriptcoregtk-4.1.so.0 libsoup-3.0.so.0 libgtk-3.so.0"

ldconfig_bin=""
for candidate in /sbin/ldconfig /usr/sbin/ldconfig /usr/bin/ldconfig; do
  if [ -x "$candidate" ]; then
    ldconfig_bin="$candidate"
    break
  fi
done

missing=""
if [ -n "$ldconfig_bin" ]; then
  cache="$("$ldconfig_bin" -p 2>/dev/null)"
  if [ -n "$cache" ]; then
    for lib in $REQUIRED; do
      printf '%s\n' "$cache" | grep -F "$lib (libc6,x86-64)" >/dev/null 2>&1 || missing="$missing $lib"
    done
  fi
fi

# The engine's signature code reads named time zones at start-up, and the
# Linux runtime takes them from the system database.
if [ ! -d /usr/share/zoneinfo ] && [ ! -d /usr/lib/zoneinfo ] && [ ! -d /usr/share/lib/zoneinfo ] && [ ! -d /etc/zoneinfo ]; then
  missing="$missing /usr/share/zoneinfo"
fi

if [ -n "$missing" ]; then
  message="Spectra PDF cannot start. These system files are missing:
$(for lib in $missing; do printf '  %s\n' "$lib"; done)
Install WebKitGTK 4.1, GTK 3 and the time zone database with the package manager:
  Debian or Ubuntu: sudo apt install libwebkit2gtk-4.1-0 libgtk-3-0 tzdata
  Fedora: sudo dnf install webkit2gtk4.1 gtk3 tzdata"
  printf '%s\n' "$message" >&2
  if [ ! -t 2 ]; then
    if command -v zenity >/dev/null 2>&1; then
      zenity --error --title="Spectra PDF" --no-wrap --text="$message" >/dev/null 2>&1
    elif command -v kdialog >/dev/null 2>&1; then
      kdialog --title "Spectra PDF" --error "$message" >/dev/null 2>&1
    elif command -v notify-send >/dev/null 2>&1; then
      notify-send "Spectra PDF" "$message" >/dev/null 2>&1
    fi
  fi
  exit 127
fi

exec "$HERE/usr/bin/spectrapdf" "$@"
