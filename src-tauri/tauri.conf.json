{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Spectra PDF",
  "version": "2026.1004.152",
  "identifier": "com.spectrapdf.app",
  "build": {
    "frontendDist": "../dist/renderer",
    "beforeBuildCommand": "npm run build:renderer",
    "beforeBundleCommand": "npm run build:shell-menu",
    "beforeDevCommand": "npm run dev:renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self'",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Jason Ulbright",
    "copyright": "Copyright (c) 2026 Jason Ulbright",
    "shortDescription": "Open-source PDF workbench for Windows",
    "longDescription": "Open-source PDF workbench for Windows",
    "createUpdaterArtifacts": true,
    "licenseFile": "../vendor/icc/Adobe-Color-Profile-License.txt",
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../resources/python": "python",
      "../resources/ghostscript": "ghostscript",
      "../resources/libreoffice": "libreoffice",
      "../resources/fonts": "fonts",
      "../resources/tesseract": "tesseract",
      "../resources/jbig2enc": "jbig2enc",
      "../resources/dictionaries": "dictionaries",
      "../resources/icc": "icc",
      "../resources/shell": "shell",
      "engine-payload": "engine",
      "../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md",
      "THIRD-PARTY-LICENSES-RUST.html": "THIRD-PARTY-LICENSES-RUST.html"
    },
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign-windows.ps1",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "displayLanguageSelector": false,
        "installerHooks": "nsis-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEQzlDNjNDODZBNkY2MEMKUldRTTlxYUdQTWJKdmJ6ck1IYytzQms1RjY3QW5lYjJRck52R0Q1emxIaGNFdVlOWllOdHc4N1gK",
      "endpoints": [
        "https://github.com/jasonulbright/Spectra-PDF/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "fs": {}
  }
}
